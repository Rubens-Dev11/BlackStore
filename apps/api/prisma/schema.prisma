// apps/api/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// CATÉGORIE
// ─────────────────────────────────────────────
model Category {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  description String?   @db.Text
  iconUrl     String?   @db.VarChar(500) @map("icon_url")
  isActive    Boolean   @default(true)   @map("is_active")
  sortOrder   Int       @default(0)      @map("sort_order")
  products    Product[]
  createdAt   DateTime  @default(now())  @map("created_at")
  updatedAt   DateTime  @updatedAt       @map("updated_at")

  @@map("categories")
}

// ─────────────────────────────────────────────
// PRODUIT
// ─────────────────────────────────────────────
enum Platform {
  android
  desktop
  multiplatform
}

model Product {
  id                  String      @id @default(uuid())
  name                String      @db.VarChar(255)
  slug                String      @unique @db.VarChar(255)
  shortDescription    String?     @db.Text          @map("short_description")
  description         String?     @db.Text
  coverImageUrl       String?     @db.VarChar(500)  @map("cover_image_url")
  screenshots         String[]
  demoVideoUrl        String?     @db.VarChar(500)  @map("demo_video_url")
  installGuide        String?     @db.Text          @map("install_guide")
  installVideoUrl     String?     @db.VarChar(500)  @map("install_video_url")
  price               Int                           // Prix en FCFA (XAF)
  originalPrice       Int?                          @map("original_price")
  categoryId          String?                       @map("category_id")
  category            Category?   @relation(fields: [categoryId], references: [id])
  tags                String[]
  version             String?     @db.VarChar(20)
  fileSizeMb          Decimal?    @db.Decimal(10, 2) @map("file_size_mb")
  platform            Platform    @default(android)
  minRequirements     Json?                         @map("min_requirements")
  changelog           Json?
  filePath            String?     @db.VarChar(500)  @map("file_path")
  fileHash            String?     @db.VarChar(64)   @map("file_hash")
  maxDownloads        Int         @default(3)        @map("max_downloads")
  downloadExpiryHours Int         @default(72)       @map("download_expiry_hours")
  downloadCount       Int         @default(0)        @map("download_count") // Inutilisé : le nombre affiché est calculé depuis les commandes payées (ProductsService)
  viewCount           Int         @default(0)        @map("view_count")
  ratingAvg           Decimal     @default(0) @db.Decimal(3, 2) @map("rating_avg")
  ratingCount         Int         @default(0)        @map("rating_count")
  isActive            Boolean     @default(false)    @map("is_active")
  isFeatured          Boolean     @default(false)    @map("is_featured")
  seoTitle            String?     @db.VarChar(70)   @map("seo_title")
  seoDescription      String?     @db.VarChar(160)  @map("seo_description")
  orderItems          OrderItem[]
  reviews             Review[]
  pageViews           PageView[]
  reports             ProductReport[]
  // Boutique du vendeur ; vide pour les produits de BlackStore. Une boutique
  // qui a des produits ne peut pas être supprimée.
  storeId             String?                        @map("store_id")
  store               Store?      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  // Validation des produits des vendeurs ; ceux de BlackStore sont validés d'office.
  reviewStatus        ProductReviewStatus @default(approved) @map("review_status")
  reviewNote          String?     @db.VarChar(500)   @map("review_note") // motif d'un refus
  submittedAt         DateTime?                      @map("submitted_at")
  reviewedAt          DateTime?                      @map("reviewed_at")
  // Analyse antivirus des fichiers déposés par les vendeurs ; vide pour ceux de l'admin.
  scanStatus          FileScanStatus?                @map("scan_status")
  scanResult          String?     @db.VarChar(200)   @map("scan_result") // nom de la menace détectée
  scannedAt           DateTime?                      @map("scanned_at")
  createdAt           DateTime    @default(now())    @map("created_at")
  updatedAt           DateTime    @updatedAt         @map("updated_at")

  @@index([storeId])
  @@index([reviewStatus])
  @@map("products")
}

enum ProductReviewStatus {
  draft    // en préparation par le vendeur
  pending  // soumis, en attente de l'administrateur
  approved // publiable
  rejected // refusé (motif dans reviewNote)
}

enum FileScanStatus {
  pending  // analyse en cours
  clean
  infected // fichier supprimé
  failed   // analyse impossible après plusieurs essais
}

// Signalement d'un produit par un visiteur, traité par l'administrateur.
model ProductReport {
  id             String       @id @default(uuid())
  productId      String                            @map("product_id")
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  reason         ReportReason
  details        String?      @db.VarChar(1000)
  reporterEmail  String?      @db.VarChar(150)     @map("reporter_email") // facultatif, pour recontacter
  ipHash         String?      @db.VarChar(64)      @map("ip_hash")        // évite les doublons d'un même visiteur
  status         ReportStatus @default(open)
  resolutionNote String?      @db.VarChar(500)     @map("resolution_note") // décision de l'administrateur
  resolvedAt     DateTime?                         @map("resolved_at")
  createdAt      DateTime     @default(now())      @map("created_at")

  @@index([status])
  @@index([productId])
  @@map("product_reports")
}

enum ReportReason {
  piracy  // copie piratée, droits non détenus
  malware // fichier dangereux
  scam    // arnaque, produit trompeur
  illegal // contenu illégal, haineux ou choquant
  broken  // fichier vide ou qui ne fonctionne pas
  other
}

enum ReportStatus {
  open
  resolved  // produit retiré
  dismissed // classé sans suite
}

// ─────────────────────────────────────────────
// COMMANDE
// ─────────────────────────────────────────────
enum OrderStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentMethod {
  orange_money
  mtn_mobile_money
  card
}

model Order {
  id               String         @id @default(uuid())
  orderNumber      String         @unique                @map("order_number")
  buyerName        String         @db.VarChar(100)       @map("buyer_name")
  buyerEmail       String         @db.VarChar(150)       @map("buyer_email")
  buyerPhone       String?        @db.VarChar(20)        @map("buyer_phone")
  totalAmount      Int                                   @map("total_amount")
  currency         String         @default("XAF") @db.VarChar(3)
  status           OrderStatus    @default(pending)
  paymentMethod    PaymentMethod?                        @map("payment_method")
  paymentReference String?        @db.VarChar(255)       @map("payment_reference")
  utmSource        String?        @db.VarChar(100)       @map("utm_source")
  utmMedium        String?        @db.VarChar(100)       @map("utm_medium")
  utmCampaign      String?        @db.VarChar(100)       @map("utm_campaign")
  utmContent       String?        @db.VarChar(100)       @map("utm_content")
  referrerUrl      String?        @db.Text               @map("referrer_url")
  // Version des conditions générales acceptées au moment de la commande.
  termsVersion     String?        @db.VarChar(20)        @map("terms_version")
  termsAcceptedAt  DateTime?                             @map("terms_accepted_at")
  items            OrderItem[]
  createdAt        DateTime       @default(now())        @map("created_at")
  paidAt           DateTime?                             @map("paid_at")
  updatedAt        DateTime       @updatedAt             @map("updated_at")

  @@map("orders")
}

// ─────────────────────────────────────────────
// ITEM DE COMMANDE
// ─────────────────────────────────────────────
model OrderItem {
  id              String          @id @default(uuid())
  orderId         String                               @map("order_id")
  order           Order           @relation(fields: [orderId], references: [id])
  productId       String                               @map("product_id")
  product         Product         @relation(fields: [productId], references: [id])
  priceAtPurchase Int                                  @map("price_at_purchase")
  downloadTokens  DownloadToken[]
  walletEntries   WalletEntry[]
  dispute         Dispute?
  createdAt       DateTime        @default(now())      @map("created_at")

  @@map("order_items")
}

// ─────────────────────────────────────────────
// TOKEN DE TÉLÉCHARGEMENT SÉCURISÉ
// ─────────────────────────────────────────────
model DownloadToken {
  id            String    @id @default(uuid())
  orderItemId   String                         @map("order_item_id")
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id])
  token         String    @unique @default(uuid())
  downloadCount Int       @default(0)          @map("download_count")
  maxDownloads  Int       @default(3)          @map("max_downloads")
  expiresAt     DateTime                       @map("expires_at")
  isActive      Boolean   @default(true)       @map("is_active")
  createdAt     DateTime  @default(now())      @map("created_at")
  updatedAt     DateTime  @updatedAt           @map("updated_at")

  @@map("download_tokens")
}

// ─────────────────────────────────────────────
// AVIS CLIENT
// ─────────────────────────────────────────────
model Review {
  id         String   @id @default(uuid())
  productId  String                        @map("product_id")
  product    Product  @relation(fields: [productId], references: [id])
  buyerEmail String   @db.VarChar(150)     @map("buyer_email")
  rating     Int      // 1 à 5
  comment    String?  @db.Text
  isApproved Boolean  @default(false)      @map("is_approved")
  createdAt  DateTime @default(now())      @map("created_at")
  updatedAt  DateTime @updatedAt           @map("updated_at")

  @@map("reviews")
}

// ─────────────────────────────────────────────
// ADMINISTRATEUR
// ─────────────────────────────────────────────
model Admin {
  id           String    @id @default(uuid())
  email        String    @unique @db.VarChar(150)
  passwordHash String    @db.VarChar(255)          @map("password_hash")
  lastLogin    DateTime?                            @map("last_login")
  isActive     Boolean   @default(true)             @map("is_active")
  createdAt    DateTime  @default(now())            @map("created_at")
  updatedAt    DateTime  @updatedAt                 @map("updated_at")

  @@map("admins")
}

// ─────────────────────────────────────────────
// VENDEUR (MARKETPLACE)
// ─────────────────────────────────────────────
enum SellerStatus {
  pending
  approved
  suspended
}

model Seller {
  id              String        @id @default(uuid())
  email           String        @unique @db.VarChar(150)
  passwordHash    String        @db.VarChar(255)       @map("password_hash")
  firstName       String        @db.VarChar(80)        @map("first_name")
  lastName        String        @db.VarChar(80)        @map("last_name")
  phone           String        @db.VarChar(20)
  status          SellerStatus  @default(pending)
  emailVerifiedAt DateTime?                            @map("email_verified_at")
  statusChangedAt DateTime?                            @map("status_changed_at")
  lastLogin       DateTime?                            @map("last_login")
  // Version des conditions vendeurs acceptées à l'inscription.
  termsVersion    String?       @db.VarChar(20)        @map("terms_version")
  termsAcceptedAt DateTime?                            @map("terms_accepted_at")
  tokens          SellerToken[]
  store           Store?
  identityChecks  IdentityCheck[]
  walletEntries   WalletEntry[]
  withdrawals     Withdrawal[]
  disputes        Dispute[]
  createdAt       DateTime      @default(now())        @map("created_at")
  updatedAt       DateTime      @updatedAt             @map("updated_at")

  @@map("sellers")
}

// Vérification d'identité d'un vendeur (selfie et CNI ou passeport), contrôlée par l'administrateur
// avant le premier retrait. Un nouvel envoi après un refus crée une nouvelle vérification.
model IdentityCheck {
  id               String               @id @default(uuid())
  sellerId         String                                @map("seller_id")
  seller           Seller               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  documentType     IdentityDocumentType                  @map("document_type")
  fullName         String               @db.VarChar(160) @map("full_name") // nom tel qu'écrit sur la pièce
  // Photos privées dans MinIO (dossier identity/) ; effacées dès qu'une vérification est refusée.
  documentFrontKey String?              @db.VarChar(255) @map("document_front_key")
  documentBackKey  String?              @db.VarChar(255) @map("document_back_key")
  selfieKey        String?              @db.VarChar(255) @map("selfie_key")
  status           IdentityCheckStatus  @default(pending)
  reviewNote       String?              @db.VarChar(500) @map("review_note") // motif d'un refus
  reviewedAt       DateTime?                             @map("reviewed_at")
  createdAt        DateTime             @default(now())  @map("created_at")

  @@index([sellerId])
  @@index([status])
  @@map("identity_checks")
}

// ── Portefeuille des vendeurs ─────────────────────────────────────────
// Le solde d'un vendeur est toujours la somme de ses mouvements, jamais un nombre modifié à la main.

// Réglages de la marketplace : une seule ligne (id « default »). Un changement ne vaut que pour l'avenir :
// chaque vente garde le taux appliqué au moment du paiement.
model MarketplaceSettings {
  id             String   @id @default("default")
  commissionRate Decimal  @default(10) @db.Decimal(5, 2) @map("commission_rate") // en %
  holdDays       Int      @default(7)                    @map("hold_days")       // délai avant qu'une vente soit retirable
  minWithdrawal  Int      @default(5000)                 @map("min_withdrawal")  // FCFA
  // Identité de l'éditeur et contact, affichés dans les pages légales (remplis par l'admin).
  legalName      String?  @db.VarChar(160)               @map("legal_name")      // personne ou société
  legalForm      String?  @db.VarChar(160)               @map("legal_form")      // ex. entreprise individuelle
  legalAddress   String?  @db.VarChar(300)               @map("legal_address")
  rccm           String?  @db.VarChar(60)
  niu            String?  @db.VarChar(30)                                         // numéro d'identifiant unique
  contactEmail   String?  @db.VarChar(150)               @map("contact_email")
  contactPhone   String?  @db.VarChar(30)                @map("contact_phone")   // aussi WhatsApp
  hostingInfo    String?  @db.VarChar(300)               @map("hosting_info")    // nom et adresse de l'hébergeur
  updatedAt      DateTime @updatedAt                     @map("updated_at")

  @@map("marketplace_settings")
}

/// Message envoyé depuis le formulaire de contact (remboursement, commande, données personnelles…).
model SupportRequest {
  id          String         @id @default(uuid())
  topic       SupportTopic
  name        String         @db.VarChar(100)
  email       String         @db.VarChar(150)
  orderNumber String?        @db.VarChar(30)      @map("order_number")
  message     String         @db.VarChar(3000)
  status      SupportStatus  @default(open)
  reply       String?        @db.Text                                 // réponse envoyée par e-mail
  repliedAt   DateTime?                           @map("replied_at")
  ipHash      String?        @db.VarChar(64)      @map("ip_hash")
  createdAt   DateTime       @default(now())      @map("created_at")
  updatedAt   DateTime       @updatedAt           @map("updated_at")

  @@index([status])
  @@map("support_requests")
}

enum SupportTopic {
  order         // commande, téléchargement
  refund        // demande de remboursement
  seller        // question d'un vendeur
  personal_data // accès, rectification, suppression de données
  other
}

enum SupportStatus {
  open
  answered
  closed
}

/// Une exécution de maintenance : sauvegarde de la base, protection des fichiers ou purge des données anciennes.
model BackupRun {
  id         String          @id @default(uuid())
  kind       BackupKind
  status     BackupRunStatus @default(running)
  trigger    String          @db.VarChar(20)                   // schedule, startup, manual
  fileName   String?         @db.VarChar(200) @map("file_name") // fichier de sauvegarde de la base
  sizeBytes  BigInt?                          @map("size_bytes")
  sha256     String?         @db.VarChar(64)
  offsite    String?         @db.VarChar(30)                   // copie hors du serveur : uploaded, disabled, failed
  details    String?         @db.Text
  startedAt  DateTime        @default(now())  @map("started_at")
  finishedAt DateTime?                        @map("finished_at")

  @@index([kind, startedAt])
  @@map("backup_runs")
}

enum BackupKind {
  database  // copie de la base (pg_dump)
  files     // versions des fichiers et copie hors du serveur
  retention // suppression des données anciennes (politique de confidentialité)
}

enum BackupRunStatus {
  running
  success
  failed
}

model WalletEntry {
  id             String          @id @default(uuid())
  sellerId       String                                @map("seller_id")
  seller         Seller          @relation(fields: [sellerId], references: [id])
  type           WalletEntryType
  amount         Int             // FCFA pour le vendeur : positif = crédit, négatif = débit
  grossAmount    Int?                                  @map("gross_amount")    // vente : prix payé par le client
  commission     Int?            // vente : part de BlackStore (négative pour un remboursement)
  commissionRate Decimal?        @db.Decimal(5, 2)     @map("commission_rate") // taux appliqué
  availableAt    DateTime                              @map("available_at")    // retirable à partir de cette date
  orderItemId    String?                               @map("order_item_id")
  orderItem      OrderItem?      @relation(fields: [orderItemId], references: [id])
  withdrawalId   String?                               @map("withdrawal_id")
  withdrawal     Withdrawal?     @relation(fields: [withdrawalId], references: [id])
  createdAt      DateTime        @default(now())       @map("created_at")

  // Une vente ou un remboursement par article, un débit ou une restitution par retrait : jamais deux fois.
  @@unique([orderItemId, type])
  @@unique([withdrawalId, type])
  @@index([sellerId, createdAt])
  @@map("wallet_entries")
}

enum WalletEntryType {
  sale               // vente payée, commission déduite
  refund             // remboursement d'une vente au client
  withdrawal         // retrait demandé
  withdrawal_reversal // retrait refusé ou annulé : l'argent revient dans le solde
}

model Withdrawal {
  id                String              @id @default(uuid())
  sellerId          String                                    @map("seller_id")
  seller            Seller              @relation(fields: [sellerId], references: [id])
  amount            Int                 // FCFA
  operator          MobileMoneyOperator
  phone             String              @db.VarChar(20)       // numéro Mobile Money (+237…)
  accountName       String              @db.VarChar(160)      @map("account_name") // titulaire du compte Mobile Money
  status            WithdrawalStatus    @default(pending)
  transferReference String?             @db.VarChar(100)      @map("transfer_reference") // référence de l'envoi Mobile Money
  adminNote         String?             @db.VarChar(500)      @map("admin_note")         // motif d'un refus
  processedAt       DateTime?                                 @map("processed_at")
  entries           WalletEntry[]
  createdAt         DateTime            @default(now())       @map("created_at")

  @@index([sellerId])
  @@index([status])
  @@map("withdrawals")
}

enum MobileMoneyOperator {
  orange // Orange Money
  mtn    // MTN Mobile Money
}

enum WithdrawalStatus {
  pending   // à payer par l'administrateur
  paid      // argent envoyé
  rejected  // refusé par l'administrateur
  cancelled // annulé par le vendeur
}

/// Lien de connexion à l'espace client, envoyé par e-mail : 30 minutes, une seule utilisation.
/// Seule l'empreinte du jeton est gardée.
model CustomerLoginToken {
  id        String    @id @default(uuid())
  email     String    @db.VarChar(150)                     // en minuscules
  tokenHash String    @unique @db.VarChar(64)  @map("token_hash")
  expiresAt DateTime                           @map("expires_at")
  usedAt    DateTime?                          @map("used_at")
  createdAt DateTime  @default(now())          @map("created_at")

  @@index([email, createdAt])
  @@map("customer_login_tokens")
}

/// Session de l'espace client (30 jours sur l'appareil), ouverte par un lien de connexion.
model CustomerSession {
  id         String   @id @default(uuid())
  email      String   @db.VarChar(150)                    // en minuscules
  tokenHash  String   @unique @db.VarChar(64) @map("token_hash")
  expiresAt  DateTime                         @map("expires_at")
  lastUsedAt DateTime @default(now())         @map("last_used_at")
  createdAt  DateTime @default(now())         @map("created_at")

  @@index([email])
  @@map("customer_sessions")
}

/// Litige : demande de remboursement d'un acheteur sur un article payé. Le vendeur répond ou corrige son
/// produit sous 5 jours, puis l'administrateur décide. Tant que le litige est ouvert (open, review), le
/// montant de la vente reste bloqué chez le vendeur. Une seule demande par article.
model Dispute {
  id                  String              @id @default(uuid())
  reference           String              @unique @db.VarChar(20)                   // LIT-2026-12345
  orderItemId         String              @unique                @map("order_item_id")
  orderItem           OrderItem           @relation(fields: [orderItemId], references: [id])
  sellerId            String?                                    @map("seller_id")  // absent : produit BlackStore
  seller              Seller?             @relation(fields: [sellerId], references: [id])
  reason              DisputeReason
  description         String              @db.VarChar(3000)
  refundOperator      MobileMoneyOperator                        @map("refund_operator")
  refundPhone         String              @db.VarChar(20)        @map("refund_phone")        // +2376XXXXXXXX
  refundAccountName   String              @db.VarChar(160)       @map("refund_account_name")
  status              DisputeStatus       @default(open)
  sellerDeadline      DateTime?                                  @map("seller_deadline")
  sellerResponse      String?             @db.VarChar(3000)      @map("seller_response")
  sellerAcceptsRefund Boolean?                                   @map("seller_accepts_refund")
  sellerRespondedAt   DateTime?                                  @map("seller_responded_at")
  decisionNote        String?             @db.VarChar(1000)      @map("decision_note")       // motif d'un refus, message au client
  decidedAt           DateTime?                                  @map("decided_at")
  refundReference     String?             @db.VarChar(100)       @map("refund_reference")    // référence de l'envoi Mobile Money
  refundedAt          DateTime?                                  @map("refunded_at")
  ipHash              String?             @db.VarChar(64)        @map("ip_hash")
  createdAt           DateTime            @default(now())        @map("created_at")
  updatedAt           DateTime            @updatedAt             @map("updated_at")

  @@index([status])
  @@index([sellerId, status])
  @@map("disputes")
}

enum DisputeReason {
  unusable         // fichier vide, abîmé ou qui ne fonctionne pas
  not_as_described // très différent de sa description
  not_received     // liens jamais reçus ou inutilisables
  double_payment   // commande payée deux fois
  removed          // produit retiré du site après l'achat (piraté, dangereux)
}

enum DisputeStatus {
  open     // en attente de la réponse du vendeur (5 jours)
  review   // à décider par l'administrateur
  accepted // remboursement accordé : argent à renvoyer au client
  refunded // remboursement envoyé (référence saisie)
  rejected // demande refusée (motif envoyé au client)
}

enum IdentityDocumentType {
  cni      // carte nationale d'identité : recto et verso
  passport // page d'identité
}

enum IdentityCheckStatus {
  pending
  approved
  rejected
}

enum SellerTokenType {
  email_verification
  password_reset
}

// Lien à usage unique envoyé par e-mail : seule son empreinte SHA-256 est stockée.
model SellerToken {
  id        String          @id @default(uuid())
  sellerId  String                                  @map("seller_id")
  seller    Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type      SellerTokenType
  tokenHash String          @unique @db.VarChar(64) @map("token_hash")
  expiresAt DateTime                                @map("expires_at")
  usedAt    DateTime?                               @map("used_at")
  createdAt DateTime        @default(now())         @map("created_at")

  @@index([sellerId, type])
  @@map("seller_tokens")
}

// ─────────────────────────────────────────────
// BOUTIQUE D'UN VENDEUR (une par vendeur en V1)
// ─────────────────────────────────────────────
model Store {
  id           String    @id @default(uuid())
  sellerId     String    @unique                  @map("seller_id")
  seller       Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name         String    @db.VarChar(60)
  slug         String    @unique @db.VarChar(40)  // adresse : /boutique/<slug>
  description  String?   @db.Text
  logoKey      String?   @db.VarChar(255)         @map("logo_key")
  facebookUrl  String?   @db.VarChar(200)         @map("facebook_url")
  instagramUrl String?   @db.VarChar(200)         @map("instagram_url")
  tiktokUrl    String?   @db.VarChar(200)         @map("tiktok_url")
  whatsapp     String?   @db.VarChar(20)
  products     Product[]
  createdAt    DateTime  @default(now())          @map("created_at")
  updatedAt    DateTime  @updatedAt               @map("updated_at")

  @@map("stores")
}

// ─────────────────────────────────────────────
// VUE DE PAGE (ANALYTICS)
// ─────────────────────────────────────────────
model PageView {
  id        String   @id @default(uuid())
  productId String?                       @map("product_id")
  product   Product? @relation(fields: [productId], references: [id])
  sessionId String?  @db.VarChar(100)     @map("session_id")
  utmSource String?  @db.VarChar(100)     @map("utm_source")
  utmMedium String?  @db.VarChar(100)     @map("utm_medium")
  ipHash    String?  @db.VarChar(64)      @map("ip_hash")
  userAgent String?  @db.Text             @map("user_agent")
  createdAt DateTime @default(now())      @map("created_at")

  @@map("page_views")
}
